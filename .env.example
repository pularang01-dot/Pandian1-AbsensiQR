# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# Publik (aman di browser). Dari Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. JANGAN diawali NEXT_PUBLIC_. Dipakai hanya di kode server
# untuk operasi istimewa (membuat akun pengguna, dsb.).
SUPABASE_SERVICE_ROLE_KEY=

# URL aplikasi (untuk tautan reset kata sandi).
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
NEXT_PUBLIC_APP_URL=https://alamat-aplikasi-anda